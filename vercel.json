{
  "version": 2,
  "buildCommand": "npm run build:all",
  "devCommand": "npm run dev:backend & npm run dev:frontend",
  "installCommand": "npm run install-all",
  "framework": "nextjs",
  "outputDirectory": "frontend/.next",
  "env": [
    "SUPABASE_URL",
    "SUPABASE_KEY",
    "NODE_ENV",
    "PORT",
    "HOST",
    "NEXT_PUBLIC_API_URL",
    "FRONTEND_URL",
    "LOG_LEVEL",
    "MAX_FILE_SIZE",
    "ALLOWED_FILE_TYPES"
  ],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    },
    {
      "src": "/(.*)",
      "dest": "frontend/.next/(.*)?"
    }
  ]
}
