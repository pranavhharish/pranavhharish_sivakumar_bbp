# MONOREPO ENVIRONMENT VARIABLES - Reference Guide
#
# This is a reference document. For local development, use the .env files in each package:
#
# Local Development Structure:
# ├── backend/.env              # Backend configuration
# ├── frontend/.env.local       # Frontend configuration (Next.js convention)
# └── database/.env             # Database initialization script
#
# See individual .env.example files in each package for actual configuration.

# ============================================
# BACKEND CONFIGURATION
# ============================================
# File: backend/.env or backend/.env.example
#
# Supabase Configuration
# Get these from: https://app.supabase.com/project/[project-id]/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Logging Configuration
LOG_LEVEL=info

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=text/csv

# Frontend URL (for CORS in development)
FRONTEND_URL=*

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# File: frontend/.env.local or frontend/.env.example
#
# Frontend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# File: database/.env or database/.env.example
#
# Supabase Database Configuration (for init-db.js script)
# Same credentials as backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
