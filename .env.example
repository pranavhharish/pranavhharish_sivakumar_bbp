# Supabase Configuration
# Get these values from: https://app.supabase.com/project/[project-id]/settings/api

# The unique URL for your Supabase project
SUPABASE_URL=https://your-project.supabase.co

# The anonymous/public key (safe to expose in frontend)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The service role key (KEEP SECRET - server-side only)
# Only needed for server-side operations and database initialization
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Node Environment
NODE_ENV=development

# Backend Server Configuration
PORT=3000
HOST=localhost

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Database Configuration (optional overrides)
# DATABASE_URL=postgresql://user:password@localhost:5432/fermentation
