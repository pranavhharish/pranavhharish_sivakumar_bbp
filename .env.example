# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/[project-id]/settings/api

# The unique URL for your Supabase project
SUPABASE_URL=https://your-project.supabase.co

# The anonymous/public key (safe to expose in frontend)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The service role key (KEEP SECRET - server-side only)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Node Environment
NODE_ENV=development

# Backend Server Configuration
PORT=3000
HOST=localhost

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=text/csv
