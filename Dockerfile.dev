FROM node:18-alpine

WORKDIR /app

# Install necessary tools
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY src ./src
COPY tsconfig.json ./
COPY vitest.config.ts ./
COPY .eslintrc.json ./
COPY .prettierrc.json ./

# Expose port
EXPOSE 3000

# Start in development mode with hot reload
CMD ["npm", "run", "dev"]
